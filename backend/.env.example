# ArrowLens — backend environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# Required: Google Gemini API key
# Obtain one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use.
# Defaults to gemini-2.0-flash if not set.
# Other options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=

# Required: Flask session secret key. Keep the real value only in .env or the
# hosting provider's environment settings; never commit it.
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Comma-separated explicit frontend origins for credentialed CORS.
# Set this to the deployed Vercel origin in Render; do not use '*'.
ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" in Render production (HTTPS). This also selects SameSite=None.
# Keep false for local HTTP development, which selects SameSite=Lax.
COOKIE_SECURE=false
